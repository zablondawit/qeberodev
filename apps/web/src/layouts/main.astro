---
import Favicon from "@/components/favicon.astro";
import FrontmatterRender from "@/components/frontmatter-render.astro";
import type { Frontmatter } from "@/types/frontmatter";
import Footer from "@components/footer.astro";
import Header from "@components/header.astro";
import type { z } from "astro/zod";
import { ClientRouter, slide, fade } from "astro:transitions";
import "../styles/index.css";
import { transitionEnabledOnThisPage } from "astro:transitions/client";
import type { TransitionAnimation, TransitionAnimationPair } from "astro";

