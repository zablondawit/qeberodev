---
import "../../styles/components/article/search.css";
import Button from "@/components/button.astro";
import Checkbox from "@/components/checkbox.astro";

type Props = Pick<HTMLElement, "id">;

const { id } = Astro.props;
---

<script>
    class ArticleSearchElement extends HTMLElement {
        dispatchSearch(query: string, options: ArticleSearchOptions): void {
            this.dispatchEvent(
                new ArticleSearchEvent({
                    query,
                    options: options,
                }),
            );
        }

        connectedCallback() {
            const searchInput = this.querySelector<HTMLInputElement>(
                "c-article-search fieldset.search input[type='text']",
            );
            const quickSearchCheckbox = this.querySelector<HTMLInputElement>(
                "c-article-search fieldset.search-options c-checkbox input[type='checkbox']",
            );

            searchInput?.addEventListener("keyup", (e) => {
                const value = (e.target as HTMLInputElement).value;
                this.dispatchSearch(value, {
                    quickSearch: !!quickSearchCheckbox?.checked,
                });
            });
        }
    }

    class ArticleSearchEvent extends CustomEvent<ArticleSearchChangeDetail> {
        constructor(detail: ArticleSearchChangeDetail) {
            super("search-change", {
                detail,
                bubbles: false,
                composed: true,
            });
        }
    }

    customElements.define("c-article-search", ArticleSearchElement);
</script>

<c-article-search id={id}>
    <fieldset class="search">
        <input class="search-input" placeholder="Search Articles" type="text" />
        <Button>Search</Button>
    </fieldset>

    <fieldset class="search-options">
        <Checkbox
            name="quick-search"
            id="quick-search"
            label="Quick Search"
            title="When enabled, search results will be shown as you type. No need to press Search!"
        />
    </fieldset>
</c-article-search>
