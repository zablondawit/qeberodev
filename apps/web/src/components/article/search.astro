<script>
    class ArticleSearchElement extends HTMLElement {
        dispatchSearch(query: string): void {
            this.dispatchEvent(
                new ArticleSearchEvent({
                    query,
                }),
            );
        }

        connectedCallback() {
            const searchInput =
                this.querySelector<HTMLInputElement>("input#search-input");

            searchInput?.addEventListener("keyup", (e) => {
                const value = (e.target as HTMLInputElement).value;
                this.dispatchSearch(value);
            });
        }
    }

    class ArticleSearchEvent extends CustomEvent<ArticleSearchChangeDetail> {
        constructor(detail: ArticleSearchChangeDetail) {
            super("search-change", {
                detail,
                bubbles: false,
                composed: true,
            });
        }
    }

    customElements.define("c-article-search", ArticleSearchElement);
</script>

<c-article-search id="article-search">
    <fieldset id="search">
        <input id="search-input" placeholder="Search Articles" type="text" />
        <Button>Search</Button>
    </fieldset>

    <fieldset id="search-options">
        <Checkbox
            name="quick-search"
            id="quick-search"
            label="Quick Search"
            title="When enabled, search results will be shown as you type. No need to press Search!"
        />
    </fieldset>
</c-article-search>
