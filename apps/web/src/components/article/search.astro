---
import "../../styles/components/article/search.css";
import Button from "@/components/button.astro";
import Checkbox from "@/components/checkbox.astro";
---

<script>
    const searchInput = document.querySelector<HTMLInputElement>(
        "section#article-search #search-input",
    );
    const quickSearchToggle = document.querySelector<HTMLInputElement>(
        "fieldset#search-options #quick-search input",
    );

    const handleSearch = () => {
        if (!quickSearchToggle) return;
        const { checked: quickSearchEnabled } = quickSearchToggle;
    };

    document.addEventListener("DOMContentLoaded", () => {
        if (!searchInput) return;

        searchInput.focus();
        searchInput.addEventListener("keydown", handleSearch);
    });
</script>

<section id="article-search">
    <fieldset id="search">
        <input id="search-input" placeholder="Search Articles" type="text" />
        <Button>Search</Button>
    </fieldset>

    <fieldset id="search-options">
        <Checkbox
            name="quick-search"
            id="quick-search"
            label="Quick Search"
            title="When enabled, search results will be shown as you type. No need to press Search!"
        />
    </fieldset>
    <!-- <fieldset>
        <Button>Filter</Button>
    </fieldset> -->
</section>
