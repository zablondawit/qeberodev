---
import "../styles/button.css";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"button"> & {
    icon?: string;
};

const { icon, ...props } = Astro.props;
---

<button {...props}>
    {icon && <Icon name="lucide:menu" />}
    <slot />
</button>
