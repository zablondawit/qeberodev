---
import type { MarkdownHeading } from "astro";
import "../../styles/components/toc.css";
import Button from "@components/button.astro";

type Props = {
    headings: MarkdownHeading[];
};
const { headings: articleHeadings } = Astro.props;

const tocData = articleHeadings.map((heading) => {
    const depthIndent = 1 * heading.depth;

    return {
        ...heading,
        depthIndent,
    };
});
---

<div id="toc-controls">
    <Button variant={"default"} icon="lucide:library" id="toc-btn">Index</Button
    >
    <aside hidden id="toc-aside">
        <div id="toc-header">
            <Button variant={"link"} icon="lucide:x" id="toc-close-btn" />
        </div>

        {
            tocData.map((heading) => (
                <Button
                    variant={"link"}
                    class="toc-btn"
                    data-slug={heading.slug}
                    style={`padding-left: ${heading.depthIndent}em`}
                >
                    {heading.text}
                </Button>
            ))
        }
    </aside>
</div>

<script>
    import { onPageLoad } from "@/lib/astro";

    onPageLoad(async () => {
        // Add click event listeners to all TOC buttons
        document
            .querySelectorAll<HTMLButtonElement>(".toc-btn")
            .forEach((tocBtn) => {
                const slug = tocBtn.dataset.slug;
                if (!slug) return;

                tocBtn.addEventListener("click", () => {
                    const targetElement = document.getElementById(slug);

                    if (targetElement) {
                        const offset = 80,
                            bodyRect =
                                document.body.getBoundingClientRect().top,
                            elementRect =
                                targetElement.getBoundingClientRect().top,
                            elementPosition = elementRect - bodyRect,
                            offsetPosition = elementPosition - offset;

                        window.scrollTo({
                            top: offsetPosition,
                            behavior: "smooth",
                        });
                    }

                    // update url
                    // Note: This will not trigger a page reload, but will update the URL in the address bar
                    // History shouldn't be updated when the user clicks the same heading multiple times,
                    // as it would create multiple entries in the browser's history stack
                    history.replaceState(null, "", `#${slug}`);
                });
            });
    });
</script>

<script>
    import { onPageLoad } from "@/lib/astro";

    onPageLoad(() => {
        const tocBtn = document.querySelector<HTMLButtonElement>("#toc-btn");
        const tocAside = document.querySelector<HTMLElement>("#toc-aside");
        const tocCloseBtn =
            document.querySelector<HTMLButtonElement>("#toc-close-btn");

        const hideToc = () => {
            if (!tocAside) return;
            tocAside.setAttribute("hidden", "hidden");
            const parent = tocBtn?.parentElement;

            parent?.classList.remove("spread");
        };
        const showToc = () => {
            if (!tocAside) return;
            tocAside.removeAttribute("hidden");
            const parent = tocBtn?.parentElement;
            parent?.classList.add("spread");
        };

        const handleTocToggle: Parameters<
            NonNullable<typeof tocBtn>["addEventListener"]
        >[1] = (event) => {
            if (!tocAside) return;
            tocAside.hasAttribute("hidden") ? showToc() : hideToc();
        };

        tocBtn?.addEventListener("click", handleTocToggle);
        tocCloseBtn?.addEventListener("click", hideToc);

        const eventsToHandle: (keyof HTMLElementEventMap)[] = [
            "click",
            "touchstart",
            "scroll",
        ] as const;
        // collapse the TOC when clicking outside of it
        // Note: This will not work if the TOC contains interactive elements (e.g., links, buttons) that can be clicked without closing the TOC
        eventsToHandle.forEach((eventType) => {
            if (eventType === "scroll") {
                document.addEventListener(eventType, (e) => e.preventDefault());
            }

            document.addEventListener(eventType, (event) => {
                if (!tocAside || !tocBtn) return;
                const target = event.target as HTMLElement;
                if (
                    target === tocBtn ||
                    tocBtn.contains(target) ||
                    tocAside.contains(target)
                ) {
                    // Click is inside the TOC or on the TOC button, do nothing
                    return;
                }
                // Click is outside the TOC, hide it
                hideToc();
            });
        });
    });
</script>
