---
import "../../styles/sections/hero.css";
---

<section id="hero-section">
    <bb-liquid-lines
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 15px; z-index: -1;"
        bg-colors="#ffffff, #ffffff"
        bg-angle="0"
        line-count="16"
        line-amplitude="20"
        line-frequency="0.002"
        speed="0.1"
        line-spacing="40"
        line-width="0.2"
        line-hue-start="0"
        line-hue-end="0"
        line-saturation="0"
        line-offset-step="0.4"
        line-colors="#00000060, #00000060"
        wiggle-amplitude="10"
        wiggle-speed="0.3"
        trail-opacity="0.5"></bb-liquid-lines>

    <h1>Build Solutions Your Brand Deserves</h1>
    <p>
        Turn your <b>business ideas</b> into carefully executed <b
            >user experiences.</b
        >
    </p>
</section>
