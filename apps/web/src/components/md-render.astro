---
import type { CollectionEntry } from "astro:content";
import "../styles/md-render.css";
import { formatArticleCardDate } from "@/lib/datetime";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { Badge } from "@/components/ui/badge";

type Props = {
    content: AstroComponentFactory;
    metadata?: CollectionEntry<"articles">["data"];
};
const { content: Content, metadata } = Astro.props;
---

<article class="md">
    {
        metadata && (
            <section id="article-header">
                {formatArticleCardDate(metadata.date)}
            </section>
        )
    }

    <h1>{metadata?.title}</h1>

    {
        metadata?.description && (
            <p id="article-description">{metadata.description}</p>
        )
    }

    <!-- Tags -->
    <span id="article-tags">
        <Badge class="category">{metadata?.category}</Badge>
        {
            metadata?.tags.map((tag) => (
                <Badge variant="outline" class="tag">
                    {tag}
                </Badge>
            ))
        }
    </span>

    <Content />
</article>

<script>
    const images = document.querySelectorAll("img");
    const headerTagNames = ["h1", "h2", "h3", "h4", "h5", "h6"] as const;
    const allHeaders = headerTagNames.map((t) => `article.md ${t}`).join(", ");
    const allHeaderElements = document.querySelectorAll<HTMLElement>(
        `${allHeaders}`,
    );

    allHeaderElements.forEach((headerElement) => {
        const id = headerElement.getAttribute("id");

        headerElement.addEventListener("click", () => {
            // update url without history entry
            history.replaceState(null, "", `#${id}`);
            // scroll to the header element
            const offset = 80,
                bodyRect = document.body.getBoundingClientRect().top,
                elementRect = headerElement.getBoundingClientRect().top,
                elementPosition = elementRect - bodyRect,
                offsetPosition = elementPosition - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: "smooth",
            });
        });
    });

    images.forEach((img) => img.addEventListener("click", () => {}));
</script>
