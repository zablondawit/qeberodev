---
import "../styles/header.css";
import Button from "@components/button.astro";
---

<header>
    <a href="/">
        <img src="/inline-logo.svg" alt="qeberodev logo" />
    </a>

    <Button icon="lucide:menu" id="nav-btn" />
    <section>
        <a href="/">Home</a>
        <a href="/articles">Articles</a>
        <a href="/about">About</a>
    </section>
</header>

<nav class="nav-hidden" aria-hidden="true" id="side-nav">
    <Button icon="lucide:x" id="close-btn" />

    <ul>
        <li>
            <a href="/">Home</a>
        </li>
        <li>
            <a href="/articles">Articles</a>
        </li>
        <li>
            <a href="/about">About</a>
        </li>
    </ul>
</nav>

<script>
    document.addEventListener("astro:page-load", () => {
        const main = document.body.querySelector<HTMLElement>("body main");

        const url = new URL(window.location.href);

        function getBasePath(pathname: string) {
            const parts = pathname.split("/").filter(Boolean);
            return parts.length > 0 ? parts[0] : "home";
        }

        const path = getBasePath(url.pathname);
        const navElements = document.querySelectorAll("section a");
        const sideNavElements = document.querySelectorAll("#side-nav a");
        const selectedSideNavElement = sideNavElements
            .entries()
            .find(([, el]) => el.textContent.toLowerCase() === path)?.[1];
        const selectedNavElement = navElements
            .entries()
            .find(([, el]) => el.textContent.toLowerCase() === path)?.[1];

        selectedNavElement?.classList.add("selected");
        selectedSideNavElement?.classList.add("selected");
    });
</script>

<script>
    document.addEventListener("astro:page-load", () => {
        const nav = document.querySelector("nav#side-nav");
        const closeBtn = document.querySelector("#side-nav #close-btn");
        const navBtn = document.querySelector("#nav-btn");

        if (!nav || !closeBtn || !navBtn) return;

        function closeNav() {
            if (!nav) return;
            nav.classList.add("nav-hidden");
            nav.setAttribute("aria-hidden", "true");
        }

        function openNav() {
            if (!nav) return;
            nav.classList.remove("nav-hidden");
            nav.setAttribute("aria-hidden", "false");
        }

        navBtn.addEventListener("click", openNav);
        closeBtn.addEventListener("click", closeNav);
    });
</script>
