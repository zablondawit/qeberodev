---
import "../../styles/article/index.css";
import MainLayout from "@layouts/main.astro";
import ArticleSearch from "@/components/article/search.astro";
import "@/components/article/search.astro";
import { FilterComponent } from "@/components/rc/filter";
// TODO: Refactor to use API route instead of fetching all articles on page load
import { retrieveArticles } from "@/lib/articles";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { compareDesc } from "date-fns";
import { getPageOGLink } from "@/lib/html-meta";
import Button from "@/components/button.astro";
import { FilterTags } from "@/components/rc/filter-by-tags";

const articles = await getCollection("articles");

const filterArticles: Parameters<
    Array<CollectionEntry<"articles">>["filter"]
>[0] = (article, index, arr) => {
    return !article.data.draft;
};

const sortArticles: Parameters<
    Array<CollectionEntry<"articles">>["sort"]
>[0] = (first, second) => compareDesc(first.data.date, second.data.date);

const filteredArticles = articles.filter(filterArticles);
filteredArticles.sort(sortArticles);

const articleCategories = (await getCollection("articles"))
    .map((a) => a.data.category)
    .filter((a): a is string => !!a)
    .reduce((acc, val: string) => {
        if (acc.includes(val)) return acc;
        return [...acc, val];
    }, [] as string[])
    .map((a) => (a.length < 4 ? a.toUpperCase() : a))
    .map(([first, ...rest]) => [first.toUpperCase(), ...rest].join(""));

const categories = articleCategories;
---

<MainLayout
    ogImage={getPageOGLink("articles", Astro.url.origin)}
    title="Articles"
>
    <ArticleSearch id="article-search" />

    <section id="article-categories">
        <Button
            id="saved-articles-btn"
            variant={"outline"}
            class="filter-btn"
            size={"xs"}
            data-category={"all"}
            icon="lucide:bookmark"
        >
            Saved
        </Button>
        <Button
            variant={"outline"}
            class="filter-btn"
            size={"xs"}
            data-category={"all"}
        >
            All
        </Button>
        {
            categories.map((category) => (
                <Button
                    variant={"outline"}
                    class="filter-btn"
                    size={"xs"}
                    data-category={category}
                >
                    {category}
                </Button>
            ))
        }
    </section>

    <section id="article-list">
        <FilterComponent articles={articles} client:only>
            <h1 slot="fallback">Loading Articles...</h1>
        </FilterComponent>
    </section>
</MainLayout>

<script>
    import { onPageLoad } from "@/lib/astro";
    import { $savedPosts, $filterBy, type FilterBy } from "@/store";
    import debounce from "debounce";

    onPageLoad(() => {
        const handleStateChange = (filterOpts: FilterBy) => {
            switch (filterOpts.type) {
                case "search":
                    if (filterOpts.query.length === 0) {
                        $filterBy.set({
                            type: "none",
                        });
                        return;
                    }
                    break;
                case "category":
                    if (!filterOpts.category) {
                        $filterBy.set({
                            type: "none",
                        });
                        return;
                    }
                    break;
                case "saved":
                    if ($savedPosts.get().length === 0) {
                        $filterBy.set({
                            type: "none",
                        });
                        return;
                    }
                    break;
                default:
                    $filterBy.set({
                        type: "none",
                    });
                    return;
            }

            $filterBy.set(filterOpts);
        };

        const filterBtns = document.querySelectorAll(".filter-btn");
        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const category = btn.getAttribute("data-category");
                if (!category) return;

                handleStateChange({
                    type: "category",
                    category,
                });
            });
        });

        const SEARCH_DELAY = 300;
        const searchComponent =
            document.querySelector<ArticleSearchElement>("#article-search");
        searchComponent?.addEventListener(
            "search-change",
            debounce(({ detail }) => {
                const { query } = detail;

                handleStateChange({
                    type: "search",
                    query,
                });
            }, SEARCH_DELAY),
        );

        const savedArticlesBtn = document.querySelector<HTMLButtonElement>(
            "#saved-articles-btn",
        );
        savedArticlesBtn?.addEventListener("click", () =>
            handleStateChange({ type: "saved" }),
        );
    });
</script>
