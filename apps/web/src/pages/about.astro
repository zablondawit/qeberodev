---
import MainLayout from "@layouts/main.astro";
import MdRender from "@/components/md-render.astro";

import { getEntry, render } from "astro:content";
import { getPageOGLink } from "@/lib/html-meta";

const about = await getEntry({
    collection: "general",
    id: "about",
});

const { Content } = await render(about);
---

<MainLayout ogImage={getPageOGLink("about", Astro.url.origin)} title="About">
    <MdRender content={Content} />
</MainLayout>
